// eip1967-constructor-args: Like eip1967, except we delegatecall to the
// implementation with the rest of the constructor arguments. This isn't
// needed by the code that we normally use, since the contract could just
// call the underlying implementation normally, but it's helpful to use
// here our deployment code.

// FIXME: this sucks! This could be optimised to swap around the starting
// stack helpers, the generated constructor needs to swap things around,
// etc. We should shift to a new macro preprocessor for EVM code! Huff2?
// Why should I do runtime addition of sizes?

#define constant SLOT_IMPL = 0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc

#define macro MAIN() = takes(0) returns(0) {
    calldatasize 0x0 0x0 calldatacopy
    0x0 0x0 calldatasize 0x0 [SLOT_IMPL] sload gas delegatecall
    0x0 returndatasize 0x0 0x0 returndatacopy
    returndatasize swap2 RETURN jumpi revert
    RETURN: return
}

#define macro CONSTRUCTOR() = takes(0) returns(0) {
    0xc145ABd8D641ca1aE5627b81EBe4884cFD31a79a 0x0 0x0
    dup3 [SLOT_IMPL] sstore
    0x09 __codesize(MAIN) __codesize(CONSTRUCTOR) add
    codesize sub sub
    dup1 dup1 codesize sub
    0x0 codecopy
    0x0 dup5 gas delegatecall iszero REVERT jumpi CONTINUE jump
    REVERT:
        0x0 0x00 revert
    CONTINUE:
}
